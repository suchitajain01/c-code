#include<iostream>
using namespace std;

int main()
{
  int a,b,c;
  cin>>a>>b;

  swap(a,b);
  cout<<"the value of the swapping are"<<a<<b;
  return 0;


}
//& means it copies the same value to the memory

void swap(int &a, int &b)
{
   int t;
   t = a;
   a = b;
   b= t;

   cout<<"the swapping values are;"<<a<<b;


}